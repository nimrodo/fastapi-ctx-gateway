# Copy to .env and fill in real values. All settings are prefixed GATEWAY_
# and documented in docs/tutorial/configuration.md.

# --- Required ---

# Your real Gemini API key, sent upstream as x-goog-api-key.
GATEWAY_GEMINI_UPSTREAM_KEY=

# JSON map of gateway-issued key -> tenant id. Clients authenticate with one
# of these keys via the x-gateway-api-key header.
GATEWAY_TENANT_API_KEYS={"some-gateway-key": "your-tenant-id"}

# --- Optional ---

# GATEWAY_REDIS_URL=redis://localhost:6379
# GATEWAY_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Unset (the default) disables the openai provider entirely - never a boot
# failure; /v1/openai/... 404s until this is set. See ADR-0006.
# GATEWAY_OPENAI_API_KEY=
# GATEWAY_OPENAI_BASE_URL=https://api.openai.com/v1

# Set false for a self-hosted "OpenAI-compatible" server (vLLM, Ollama, ...)
# that 400s on stream_options.include_usage.
# GATEWAY_OPENAI_INCLUDE_USAGE=true

# Unset (the default) disables the semantic cache entirely - never a boot
# failure. Point at a real exported ONNX embedding model to enable it.
# GATEWAY_EMBEDDING_MODEL_PATH=
# GATEWAY_CACHE_DISTANCE_THRESHOLD=0.10
# GATEWAY_CACHE_TTL_S=3600
# GATEWAY_CACHE_TEMPERATURE_THRESHOLD=0.3
# GATEWAY_CACHE_LOOKUP_TIMEOUT_MS=50

# GATEWAY_TOKEN_BUDGETS={"budgets": {"gemini-3.7-flash": 32000, "gemini-2.5-pro": 64000}, "default": 32000}

# GATEWAY_RPM_LIMIT=60
# GATEWAY_TPM_LIMIT=100000
# GATEWAY_RATE_LIMIT_WINDOW_S=60

# GATEWAY_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# GATEWAY_CIRCUIT_BREAKER_RESET_TIMEOUT_S=30.0

# GATEWAY_HOST=0.0.0.0
# GATEWAY_PORT=8000
# GATEWAY_WORKERS=1
